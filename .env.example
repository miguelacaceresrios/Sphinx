# --- Credenciales de Telegram (sacar en https://my.telegram.org) ---
TG_API_ID=123456
TG_API_HASH=abcdef1234567890abcdef1234567890

# --- Canal(es) a indexar ---
# Puede ser el @username del canal, o el link de invitación (empieza con https://t.me/+...)
TG_CHANNEL=@nombre_del_canal

# --- Token del bot de consulta (sacar con @BotFather en Telegram) ---
TG_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- API key de Anthropic (para generar resúmenes y responder preguntas) ---
ANTHROPIC_API_KEY=sk-ant-...

# Solo el/los usuarios con este ID pueden usar el bot (opcional, separa varios con coma)
# Para saber tu ID, escríbele a @userinfobot en Telegram
ALLOWED_USER_IDS=
